      "page_end": 22
    },
    {
      "text": "𝑅(𝑖, 𝑗) = 𝑐(𝑖, 𝑗) + smoothMin\u0000𝑅(𝑖−1, 𝑗−1), 𝑅(𝑖−1, 𝑗), 𝑅(𝑖, 𝑗−1); 𝛾\u0001",
